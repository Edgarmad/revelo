---
import Container from '@/components/common/Container.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ProductGrid from '@/components/product/ProductGrid.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getDiscountedProducts } from '@/services/productService';

const products = getDiscountedProducts();
---

<MainLayout title="Productos con descuento | Milapro Home" description="Explora una selección de productos con descuento en plantas, aluminio, ratán, plástico y outlet.">
  <Container class="py-14">
    <SectionHeading eyebrow="Ofertas" title="Productos con descuento" description="Una selección de cada categoría con precios especiales para terrazas, jardines y proyectos comerciales." />
    <div class="mt-6 flex items-center justify-between text-sm text-muted">
      <span data-product-count>{products.length} productos</span>
    </div>
    <div class="mt-8"><ProductGrid products={products} /></div>
  </Container>
</MainLayout>
