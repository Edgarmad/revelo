---
import { navItems } from '@/data/siteContent';
import Container from '@/components/common/Container.astro';
import { ChevronDown, Facebook, Instagram, Menu, MessageCircle, Search, X } from 'lucide-astro';
import { getAllCategories } from '@/services/categoryService';
import { getAllProducts, getDiscountedProducts } from '@/services/productService';
import logoSrc from '@/styles/images/Logo Mila.svg';
import type { HomeBanner } from '@/services/homeBannerService';

interface Props {
  banner?: HomeBanner;
}

const { banner } = Astro.props;

const menuCategories = await getAllCategories();
const furnitureCategories = menuCategories.filter((category) => ['aluminio', 'ratan', 'plastico', 'plantas'].includes(category.slug));
const menuProductCategories = new Set<string>();
const menuProducts = (await getDiscountedProducts())
  .filter((product) => {
    if (menuProductCategories.has(product.category)) return false;
    menuProductCategories.add(product.category);
    return true;
  })
  .slice(0, 5);
const searchProducts = await getAllProducts();
const promotionsHref = '/products/?promociones=1';
const promoText = banner ? `${banner.eyebrow} - ${banner.title}` : 'Oferta de verano - Hasta 50% de descuento';
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="bg-ink py-2 text-white">
    <Container class="relative flex min-h-6 items-center overflow-hidden whitespace-nowrap text-xs font-bold">
      <span class="promo-marquee" data-home-banner-slot="carousel_banner" data-home-banner-title>{promoText}</span>
      <a class="relative z-10 ml-auto shrink-0 rounded-pill bg-aqua px-4 py-1 text-ink" href={promotionsHref}>Ver ofertas</a>
    </Container>
  </div>
  <Container class="relative grid min-h-[56px] grid-cols-[48px_minmax(0,1fr)_96px] items-center gap-2 bg-white shadow-[0_6px_14px_rgb(35_31_28/0.12)] lg:min-h-[82px] lg:grid-cols-[220px_minmax(0,1fr)_auto] lg:gap-4 lg:shadow-none xl:grid-cols-[260px_minmax(0,1fr)_auto]">
    <button class="grid h-11 w-11 place-items-center justify-self-start text-ink lg:hidden" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú"><Menu size={25} /></button>
    <a href="/" class="inline-flex items-center justify-self-center lg:justify-self-start" aria-label="Milapro Home">
      <img class="mt-[7px] h-[25px] w-auto lg:mt-0 lg:h-auto lg:w-[220px] lg:max-w-[42vw] lg:pt-[10px] xl:w-[260px]" src={logoSrc} alt="Milapro Home" width="260" height="25" />
    </a>
    <nav class="hidden items-center gap-5 text-sm font-bold text-[#332b1e] lg:flex lg:justify-self-center xl:gap-[34px]" aria-label="Navegación principal">
      {
        navItems.map((item) => {
          if (item.label === 'Muebles para exterior') {
            return (
              <div class="py-8" data-mega-item>
                <a class="inline-flex items-center gap-1 transition hover:text-aqua focus-visible:text-aqua" href={item.href} data-mega-trigger>
                  {item.label}
                  <ChevronDown class="transition" size={14} data-mega-chevron />
                </a>
                <div class="mega-menu-panel pointer-events-none absolute left-0 top-full w-full translate-y-2 border-t border-ink/10 bg-white opacity-0 shadow-2xl transition duration-200" data-mega-panel>
                  <Container class="grid gap-12 py-12 lg:grid-cols-[0.95fr_1.05fr]">
                    <div>
                      <p class="text-sm font-black uppercase tracking-[0.18em] text-aqua">Muebles para exterior</p>
                      <h2 class="mt-4 font-display text-5xl font-light uppercase tracking-wide text-ink">Compra por categoría</h2>
                      <div class="mt-8 grid max-w-xl gap-6">
                        {furnitureCategories.map((category) => (
                          <a class="flex items-center justify-between border-b border-ink/10 pb-5 text-3xl font-light uppercase tracking-wide text-ink transition hover:text-aqua" href={`/categories/${category.slug}/`}>
                            {category.name}
                            <span class="grid h-9 w-9 place-items-center rounded-full border border-ink/30 text-xl leading-none">↗</span>
                          </a>
                        ))}
                      </div>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                      {furnitureCategories.map((category) => (
                        <a class="group/card" href={`/categories/${category.slug}/`}>
                          <img class="aspect-[1.35/1] w-full rounded-xl bg-sand object-cover transition group-hover/card:scale-[1.02]" src={category.image} alt={category.name} loading="lazy" width="500" height="370" />
                          <p class="mt-2 text-center text-xs font-semibold text-muted">{category.name}</p>
                        </a>
                      ))}
                    </div>
                  </Container>
                </div>
              </div>
            );
          }

          if (item.label === '🔥 Sale') {
            return (
              <div class="py-8" data-mega-item>
                <a class="inline-flex items-center gap-1 transition hover:text-aqua focus-visible:text-aqua" href={promotionsHref} data-mega-trigger>
                  {item.label}
                  <ChevronDown class="transition" size={14} data-mega-chevron />
                </a>
                <div class="mega-menu-panel pointer-events-none absolute left-0 top-full w-full translate-y-2 border-t border-ink/10 bg-white opacity-0 shadow-2xl transition duration-200" data-mega-panel>
                  <Container class="grid gap-12 py-12 lg:grid-cols-[0.95fr_1.05fr]">
                    <div>
                      <p class="text-sm font-black uppercase tracking-[0.18em] text-aqua">Productos</p>
                      <h2 class="mt-4 font-display text-5xl font-light uppercase tracking-wide text-ink">Productos con descuento</h2>
                      <div class="mt-8 grid max-w-xl gap-6">
                        {menuProducts.map((product) => (
                          <a class="flex items-center justify-between border-b border-ink/10 pb-5 text-3xl font-light uppercase tracking-wide text-ink transition hover:text-aqua" href={`/products/${product.slug}/`}>
                            {product.name}
                            <span class="grid h-9 w-9 place-items-center rounded-full border border-ink/30 text-xl leading-none">↗</span>
                          </a>
                        ))}
                      </div>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                      {menuProducts.map((product) => (
                        <a class="group/card" href={`/products/${product.slug}/`}>
                          <img class="aspect-[1.35/1] w-full rounded-xl bg-sand object-cover transition group-hover/card:scale-[1.02]" src={product.mainImage} alt={product.name} loading="lazy" width="500" height="370" />
                          <p class="mt-2 text-center text-xs font-semibold text-muted">{product.name}</p>
                        </a>
                      ))}
                    </div>
                  </Container>
                </div>
              </div>
            );
          }

          return (
            <a class="transition hover:text-cocoa" href={item.href}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="hidden items-center justify-self-end gap-2 lg:flex">
      <div class="relative" data-product-search>
        <button class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 text-ink transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" type="button" data-product-search-toggle aria-expanded="false" aria-controls="desktop-product-search" aria-label="Abrir buscador de productos"><Search size={20} /></button>
        <div id="desktop-product-search" class="absolute right-0 top-[calc(100%+14px)] hidden w-[420px] overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-2xl" data-product-search-panel>
          <div class="flex items-center gap-3 border-b border-ink/10 px-4 py-3">
            <Search class="shrink-0 text-aqua" size={20} />
            <input class="h-11 min-w-0 flex-1 bg-transparent text-base font-semibold text-ink outline-none placeholder:text-muted" type="search" placeholder="Buscar productos" autocomplete="off" data-product-search-input />
            <button class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-muted transition hover:bg-sand hover:text-ink" type="button" data-product-search-close aria-label="Cerrar buscador"><X size={18} /></button>
          </div>
          <div class="max-h-[420px] overflow-y-auto p-3" data-product-search-results>
            {searchProducts.map((product, index) => (
              <a class:list={["flex items-center gap-3 rounded-xl p-2 transition hover:bg-sand", index >= 8 && "hidden"]} href={`/products/${product.slug}/`} data-product-result data-search-text={`${product.name} ${product.collection} ${product.category} ${product.tags.join(' ')}`}>
                <img class="h-14 w-14 rounded-lg bg-sand object-cover" src={product.mainImage} alt="" loading="lazy" width="56" height="56" />
                <span class="min-w-0">
                  <span class="block truncate text-sm font-black text-ink">{product.name}</span>
                  <span class="block text-xs font-semibold uppercase tracking-wide text-muted">{product.collection}</span>
                </span>
              </a>
            ))}
            <p class="hidden px-3 py-8 text-center text-sm font-semibold text-muted" data-product-search-empty>No encontramos productos con ese nombre.</p>
          </div>
        </div>
      </div>
      <a class="grid h-10 w-10 place-items-center rounded-full bg-[#25d366] text-ink transition hover:bg-ink hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://wa.me/529994553932" target="_blank" rel="noreferrer" aria-label="Abrir WhatsApp de Milapro Home"><MessageCircle size={18} /></a>
      <div class="flex items-center gap-1 text-ink">
        <a class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.milaprohome.com/website/social/facebook" target="_blank" rel="noreferrer" aria-label="Facebook de Milapro Home"><Facebook size={18} /></a>
        <a class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.milaprohome.com/website/social/instagram" target="_blank" rel="noreferrer" aria-label="Instagram de Milapro Home"><Instagram size={18} /></a>
        <a class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.tiktok.com/@milapro.home?_r=1&_t=ZS-98ai5EvgcFE" target="_blank" rel="noreferrer" aria-label="TikTok de Milapro Home">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M16.6 5.82a5.72 5.72 0 0 0 3.31 1.06v3.36a9.05 9.05 0 0 1-3.31-.66v6.03a5.58 5.58 0 1 1-5.58-5.58c.33 0 .65.03.96.09v3.47a2.21 2.21 0 1 0 1.26 2v-13h3.36v3.23Z" /></svg>
        </a>
      </div>
    </div>
    <div class="flex items-center justify-self-end lg:hidden">
      <a class="grid h-11 w-11 place-items-center text-ink" href="/products/" aria-label="Buscar productos"><Search size={22} /></a>
    </div>
  </Container>
  <a class="fixed bottom-24 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25d366] text-white shadow-[0_10px_28px_rgb(35_31_28/0.25)] transition hover:bg-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua lg:hidden" href="https://wa.me/529994553932" target="_blank" rel="noreferrer" aria-label="Abrir WhatsApp de Milapro Home">
    <MessageCircle size={30} />
  </a>
  <Container class="flex items-center justify-center gap-2 border-t border-ink/10 bg-white py-2 text-ink shadow-[0_6px_14px_rgb(35_31_28/0.08)] lg:hidden">
    <a class="grid h-9 w-9 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.milaprohome.com/website/social/facebook" target="_blank" rel="noreferrer" aria-label="Facebook de Milapro Home"><Facebook size={17} /></a>
    <a class="grid h-9 w-9 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.milaprohome.com/website/social/instagram" target="_blank" rel="noreferrer" aria-label="Instagram de Milapro Home"><Instagram size={17} /></a>
    <a class="grid h-9 w-9 place-items-center rounded-full border border-ink/10 transition hover:border-aqua hover:bg-aqua/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-aqua" href="https://www.tiktok.com/@milapro.home?_r=1&_t=ZS-98ai5EvgcFE" target="_blank" rel="noreferrer" aria-label="TikTok de Milapro Home">
      <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M16.6 5.82a5.72 5.72 0 0 0 3.31 1.06v3.36a9.05 9.05 0 0 1-3.31-.66v6.03a5.58 5.58 0 1 1-5.58-5.58c.33 0 .65.03.96.09v3.47a2.21 2.21 0 1 0 1.26 2v-13h3.36v3.23Z" /></svg>
    </a>
  </Container>
  <div id="mobile-menu" class="fixed inset-0 top-0 z-[60] hidden bg-ink/45 pt-[33vh] lg:hidden" data-mobile-menu>
    <div class="mx-6 flex min-h-[62vh] flex-col overflow-hidden rounded-t-xl bg-white shadow-2xl">
      <div class="flex min-h-[60px] items-center justify-center gap-3 bg-[#f7f7f7] text-sm uppercase text-ink">
        <button class="inline-flex items-center gap-3" type="button" data-menu-close aria-label="Cerrar menú"><X size={28} /> Close</button>
      </div>
      <nav class="grid gap-4 px-6 py-8 text-xl font-black text-ink" aria-label="Navegación móvil" data-mobile-menu-main>
        <button class="flex items-center justify-between text-left" type="button" data-mobile-submenu-open="products"><span>Muebles para exterior</span><span class="grid h-6 min-w-16 place-items-center rounded-pill bg-aqua text-2xl font-light leading-none">→</span></button>
        <a class="flex items-center justify-between" href={promotionsHref}><span>🔥 Sale</span><span class="grid h-6 min-w-16 place-items-center rounded-pill bg-aqua text-2xl font-light leading-none">→</span></a>
        <a href="/#reviews">Opiniones</a>
        <a class="flex items-center justify-between" href="/about/"><span>Acerca de</span><span class="grid h-6 min-w-16 place-items-center rounded-pill bg-aqua text-2xl font-light leading-none">→</span></a>
        <a href="/contact/">Contacto</a>
      </nav>
      <nav class="hidden px-6 py-8 text-ink" aria-label="Categorías móviles" data-mobile-menu-submenu>
        <button class="mb-5 inline-flex items-center gap-3 text-base font-bold text-muted" type="button" data-mobile-submenu-back><span class="text-2xl leading-none">‹</span> Muebles para exterior</button>
        <div class="grid gap-7">
          {furnitureCategories.map((category) => (
            <a class="flex items-center justify-between text-2xl font-black uppercase" href={`/categories/${category.slug}/`}>
              {category.name}
              <span class="grid h-9 w-9 place-items-center rounded-full border border-ink/80 text-xl font-light leading-none">↗</span>
            </a>
          ))}
        </div>
      </nav>
      <div class="mt-auto border-t border-ink/10 px-6 py-8 text-center text-sm text-muted">ventas@milaprohome.com</div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const megaItems = document.querySelectorAll<HTMLElement>('[data-mega-item]');
  const productSearch = document.querySelector<HTMLElement>('[data-product-search]');
  const productSearchToggle = document.querySelector<HTMLButtonElement>('[data-product-search-toggle]');
  const productSearchPanel = document.querySelector<HTMLElement>('[data-product-search-panel]');
  const productSearchInput = document.querySelector<HTMLInputElement>('[data-product-search-input]');
  const productSearchClose = document.querySelector<HTMLButtonElement>('[data-product-search-close]');
  const productResults = Array.from(document.querySelectorAll<HTMLElement>('[data-product-result]'));
  const productSearchEmpty = document.querySelector<HTMLElement>('[data-product-search-empty]');
  let megaCloseTimer: ReturnType<typeof setTimeout> | undefined;

  const normalizeSearch = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  const filterProductResults = () => {
    const query = normalizeSearch(productSearchInput?.value ?? '');
    let visibleCount = 0;

    productResults.forEach((result, index) => {
      const searchText = normalizeSearch(result.dataset.searchText ?? '');
      const visible = query ? searchText.includes(query) : index < 8;
      result.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });

    productSearchEmpty?.classList.toggle('hidden', visibleCount > 0);
  };

  const setProductSearchOpen = (open: boolean) => {
    productSearchPanel?.classList.toggle('hidden', !open);
    productSearchToggle?.setAttribute('aria-expanded', String(open));

    if (open) {
      closeMegaMenus();
      filterProductResults();
      window.setTimeout(() => productSearchInput?.focus(), 0);
      return;
    }

    if (productSearchInput) productSearchInput.value = '';
    filterProductResults();
  };

  const closeMegaMenus = () => {
    megaItems.forEach((item) => {
      item.querySelector<HTMLElement>('[data-mega-trigger]')?.classList.remove('text-aqua');
      item.querySelector<HTMLElement>('[data-mega-chevron]')?.classList.remove('rotate-180');
      item.querySelector<HTMLElement>('[data-mega-panel]')?.classList.remove('mega-menu-panel-open');
    });
  };

  const openMegaMenu = (item: HTMLElement) => {
    window.clearTimeout(megaCloseTimer);
    closeMegaMenus();
    item.querySelector<HTMLElement>('[data-mega-trigger]')?.classList.add('text-aqua');
    item.querySelector<HTMLElement>('[data-mega-chevron]')?.classList.add('rotate-180');
    item.querySelector<HTMLElement>('[data-mega-panel]')?.classList.add('mega-menu-panel-open');
  };

  const scheduleMegaClose = () => {
    window.clearTimeout(megaCloseTimer);
    megaCloseTimer = window.setTimeout(closeMegaMenus, 500);
  };

  megaItems.forEach((item) => {
    item.addEventListener('mouseenter', () => openMegaMenu(item));
    item.addEventListener('mouseleave', scheduleMegaClose);
    item.addEventListener('focusin', () => openMegaMenu(item));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) scheduleMegaClose();
    });
  });

  productSearchToggle?.addEventListener('click', () => {
    setProductSearchOpen(productSearchPanel?.classList.contains('hidden') ?? true);
  });
  productSearchClose?.addEventListener('click', () => setProductSearchOpen(false));
  productSearchInput?.addEventListener('input', filterProductResults);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setProductSearchOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (!productSearch?.contains(event.target as Node | null)) setProductSearchOpen(false);
  });

  const mobileMainMenu = menu?.querySelector<HTMLElement>('[data-mobile-menu-main]');
  const mobileSubmenu = menu?.querySelector<HTMLElement>('[data-mobile-menu-submenu]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('overflow-hidden', open);
    if (!open) {
      mobileSubmenu?.classList.add('hidden');
      mobileMainMenu?.classList.remove('hidden');
    }
  };
  toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? true));
  close?.addEventListener('click', () => setOpen(false));

  menu?.querySelector<HTMLElement>('[data-mobile-submenu-open]')?.addEventListener('click', () => {
    mobileMainMenu?.classList.add('hidden');
    mobileSubmenu?.classList.remove('hidden');
  });
  menu?.querySelector<HTMLElement>('[data-mobile-submenu-back]')?.addEventListener('click', () => {
    mobileSubmenu?.classList.add('hidden');
    mobileMainMenu?.classList.remove('hidden');
  });
</script>

<style>
  .mega-menu-panel-open {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  .promo-marquee {
    display: inline-block;
    padding-left: 100%;
    animation: promo-marquee 14s linear infinite;
  }

  @keyframes promo-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }
</style>
