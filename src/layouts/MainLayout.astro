---
import '@/styles/global.css';
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/navigation/Footer.astro';
import FloatingBanner from '@/components/common/FloatingBanner.astro';
import { getHomeBanners, type HomeBanners } from '@/services/homeBannerService';

interface Props {
  title: string;
  description: string;
  homeBanners?: HomeBanners;
}

const { title, description, homeBanners: providedHomeBanners } = Astro.props;
const showFloatingBanner = Astro.url.pathname === '/';
const homeBanners = providedHomeBanners ?? (showFloatingBanner ? await getHomeBanners() : undefined);
const homeBannersApiUrl = `${import.meta.env.WORDPRESS_API_URL?.replace(/\/wp\/v2\/?$/, '') || 'https://cms.milaprohome.com/wp-json'}/milapro/v1/home-banners`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <Header banner={homeBanners?.carousel_banner} />
    <main>
      <slot />
    </main>
    <Footer />
    {showFloatingBanner && <FloatingBanner banner={homeBanners?.popup_banner} />}
    <script is:inline define:vars={{ homeBannersApiUrl }}>
      fetch(homeBannersApiUrl, { cache: 'no-store' })
        .then((response) => (response.ok ? response.json() : null))
        .then((banners) => {
          if (!banners) return;

          document.querySelectorAll('[data-home-banner-slot]').forEach((slot) => {
            const key = slot.getAttribute('data-home-banner-slot');
            const banner = key ? banners[key] : null;
            if (!banner) return;
            const findField = (selector) => slot.matches(selector) ? slot : slot.querySelector(selector);

            const image = findField('[data-home-banner-image]');
            const eyebrow = findField('[data-home-banner-eyebrow]');
            const title = findField('[data-home-banner-title]');
            const text = findField('[data-home-banner-text]');

            if (image && banner.image_url) image.src = banner.image_url;
            if (image && banner.title) image.alt = banner.title;
            if (eyebrow && banner.eyebrow) eyebrow.textContent = banner.eyebrow;
            if (title && banner.title) {
              title.textContent = key === 'carousel_banner' && banner.eyebrow ? `${banner.eyebrow} - ${banner.title}` : banner.title;
            }
            if (text) {
              text.textContent = banner.text || '';
              text.classList.toggle('hidden', !banner.text);
            }
          });
        })
        .catch(() => {});
    </script>
    <script src="/scripts/subscribe.js" defer></script>
  </body>
</html>
