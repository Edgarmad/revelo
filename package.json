  },
  "dependencies": {
    "@astrojs/tailwind": "3.1.3",
    "astro": "2.10.15",
    "lucide-astro": "^0.468.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.4.5"
  },
  "devDependencies": {}
}
