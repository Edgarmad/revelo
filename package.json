{
  "name": "revelo-catalog-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.8.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "wp:products:build": "node scripts/build-productos-mila-web.mjs",
    "wp:seed:build": "node scripts/build-wordpress-seed.mjs",
    "wp:seed:import": "docker compose --profile tools run --rm wpcli wp eval-file /var/www/html/migration/import-seed.php",
