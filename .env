WORDPRESS_API_URL=http://localhost:8080/index.php?rest_route=/wp/v2
WORDPRESS_SITE_URL=http://localhost:8080
WORDPRESS_API_TIMEOUT_MS=8000

# Used by the WordPress plugin to trigger a frontend rebuild/deploy.
MILAPRO_REBUILD_WEBHOOK_URL=
MILAPRO_REBUILD_WEBHOOK_SECRET=

# GitHub Actions deploy secrets for HostGator are configured in GitHub, not here:
# FTP_HOST=
# FTP_USERNAME=
# FTP_PASSWORD=
# FTP_TARGET_DIR=/public_html
